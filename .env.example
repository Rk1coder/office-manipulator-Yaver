# Copy to .env and fill in values — never commit .env
DB_PASSWORD=changeme
OFFICE_JWT_SECRET=changeme
BUDGET_LIMIT_USD=20.00
FILE_TTL_HOURS=72

# ── LLM (customer's own key; the server pays for no LLM usage) ─────────────────
# Provider: one of anthropic | gemini | openai (fixed whitelist, fixed endpoints).
# Leave the selected provider's key blank for air-gapped deployments: AI/chat endpoints
# (/api/chat, the Yaver Agent plugin) return 503 until the key is verified with
# "Kontrol et" in Settings (internet required); file storage and ONLYOFFICE editing
# work either way.
#
# User-facing API requests may override these per request with the optional fields
# llm_provider / llm_api_key / llm_model. Background/scheduled work always uses the
# values below.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional: uncomment and set only for a self-hosted/proxy endpoint compatible with
# the Anthropic Messages API. Leave commented out (or unset) to use the official
# https://api.anthropic.com — do not set this to an empty value, that disables the
# built-in default instead of using it.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Also used for Gemini image generation below.
GEMINI_API_KEY=
GEMINI_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

# Price of the default model (USD per million tokens), used by the budget guard.
# Blank uses built-in rates (Sonnet 4.6: 3/15; Sonnet 5: 2/10). Gemini/OpenAI
# models require explicit current prices.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=

# Presentations: after a deck validates, its slides are rendered (ONLYOFFICE) and shown to the
# model, which fixes visible defects. Each round costs one review call plus one regeneration. 0 = off.
PRESENTATION_REVIEW_ROUNDS=2

# Optional: enables Gemini/Imagen image generation for presentation plans (uses GEMINI_API_KEY above)
GEMINI_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Gemini remains disabled until positive prices are explicitly configured.
GEMINI_INPUT_PRICE_PER_MILLION=0
GEMINI_OUTPUT_PRICE_PER_MILLION=0
