# Copy to .env and fill in values — never commit .env
DB_PASSWORD=changeme
OFFICE_JWT_SECRET=changeme
BUDGET_LIMIT_USD=20.00
FILE_TTL_HOURS=72
CLAUDE_MODEL=claude-sonnet-4-6

# Optional: leave blank for air-gapped deployments. AI/chat endpoints (/api/chat,
# the Yaver Agent plugin) return 503 until the key is verified with "Kontrol et"
# in Settings (internet required); file storage and
# ONLYOFFICE editing work either way.
ANTHROPIC_API_KEY=

# Optional: uncomment and set only for a self-hosted/proxy endpoint compatible with
# the Anthropic Messages API. Leave commented out (or unset) to use the official
# https://api.anthropic.com — do not set this to an empty value, that disables the
# built-in default instead of using it.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Optional: enables Gemini/Imagen image generation for presentation plans
GEMINI_API_KEY=
GEMINI_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Blank prices use model-specific rates (Sonnet 4.6: 3/15; Sonnet 5: 2/10 USD per million).
# Other models require explicit current prices.
CLAUDE_INPUT_PRICE_PER_MILLION=
CLAUDE_OUTPUT_PRICE_PER_MILLION=
# Gemini remains disabled until positive prices are explicitly configured.
GEMINI_INPUT_PRICE_PER_MILLION=0
GEMINI_OUTPUT_PRICE_PER_MILLION=0
