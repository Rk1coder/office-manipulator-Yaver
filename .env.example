# Copy to .env and fill in values — never commit .env
DB_PASSWORD=changeme
OFFICE_JWT_SECRET=changeme
BUDGET_LIMIT_USD=20.00
FILE_TTL_HOURS=72

# ── LLM (customer's own key; the server pays for no LLM usage) ─────────────────
# Provider: one of anthropic | gemini | openai | openai_compatible (fixed whitelist).
# Leave the selected provider's key blank for air-gapped deployments: AI/chat endpoints
# (/api/chat, the Yaver Agent plugin) return 503 until the key is verified with
# "Kontrol et" in Settings (internet required); file storage and ONLYOFFICE editing
# work either way.
#
# User-facing API requests may override these per request with the optional fields
# llm_provider / llm_api_key / llm_model. Background/scheduled work always uses the
# values below.
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
# Optional: uncomment and set only for a self-hosted/proxy endpoint compatible with
# the Anthropic Messages API. Leave commented out (or unset) to use the official
# https://api.anthropic.com — do not set this to an empty value, that disables the
# built-in default instead of using it.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Also used for Gemini image generation below.
GEMINI_API_KEY=
GEMINI_MODEL=

OPENAI_API_KEY=
OPENAI_MODEL=

# openai_compatible: any OpenAI Chat Completions server — vLLM, Ollama, LM Studio, Groq,
# Mistral, DeepSeek, OpenRouter... The URL is read only from here, never from a request.
# vLLM must run with tool calling on: --enable-auto-tool-choice --tool-call-parser <hermes|llama3_json|...>
# Examples: vLLM http://vllm:8000/v1 · Ollama http://ollama:11434/v1 · Groq https://api.groq.com/openai/v1
# API key: EMPTY for a server without auth (vLLM default). Self-hosted models cost 0;
# for hosted APIs set LLM_INPUT/OUTPUT_PRICE_PER_MILLION below.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=EMPTY
OPENAI_COMPATIBLE_MODEL=
# Multi-file requests: combined source text cap in characters (~4 chars per token). Refused above it, never
# truncated. Keep it under the model's context, e.g. 80000 for a 32k-token vLLM.
MAX_SOURCE_CHARS=400000

# Price of the default model (USD per million tokens), used by the budget guard.
# Blank uses built-in rates (Sonnet 4.6: 3/15; Sonnet 5: 2/10). Gemini/OpenAI
# models require explicit current prices.
LLM_INPUT_PRICE_PER_MILLION=
LLM_OUTPUT_PRICE_PER_MILLION=

# Presentations: after a deck validates, its slides are rendered (ONLYOFFICE) and shown to the
# model, which fixes visible defects. Each round costs one review call plus one regeneration. 0 = off.
PRESENTATION_REVIEW_ROUNDS=2
# Slayt incelemesi için ayrı görsel model (aynı sağlayıcı ve anahtar). Görsel okuyamayan bir
# üretici model (örn. openai/gpt-oss-120b) kullanılıyorsa gerekli. Boş = üretici model inceler.
PRESENTATION_REVIEW_MODEL=
PRESENTATION_REVIEW_INPUT_PRICE_PER_MILLION=0
PRESENTATION_REVIEW_OUTPUT_PRICE_PER_MILLION=0

# Optional: enables Gemini/Imagen image generation for presentation plans (uses GEMINI_API_KEY above)
GEMINI_ENABLED=false
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview
# Optional: generate images through an OpenAI-compatible endpoint instead of Google's Gemini API, e.g.
# https://openrouter.ai/api/v1 with GEMINI_IMAGE_MODEL=google/gemini-2.5-flash-image. Blank GEMINI_API_KEY then
# reuses OPENAI_COMPATIBLE_API_KEY. Set GEMINI_*_PRICE_PER_MILLION to that model's prices (image output per token).
IMAGE_OPENAI_COMPATIBLE_BASE_URL=

# Gemini remains disabled until positive prices are explicitly configured.
GEMINI_INPUT_PRICE_PER_MILLION=0
GEMINI_OUTPUT_PRICE_PER_MILLION=0
