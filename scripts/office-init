#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."
if [[ ! -e .office.local.env ]]; then
  (umask 077; python3 - <<'PY'
from pathlib import Path
import secrets
path = Path('.office.local.env')
with path.open('x') as output:
    output.write('OFFICE_JWT_SECRET=' + secrets.token_hex(32) + '\n')
    output.write('OFFICE_DB_PASSWORD=' + secrets.token_hex(32) + '\n')
PY
  )
fi
chmod 600 .office.local.env
printf '%s\n' 'Trial secrets are ready in .office.local.env (values hidden).'
